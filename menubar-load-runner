#!/usr/bin/env zsh
set -euo pipefail

readonly APP_CMD_NAME="menubar-load-runner/menubar-load-runner"

# Absolute, symlink-resolved path of THIS script. The app re-execs it for the update prompt's
# Restart button (exported as MENUBAR_LOAD_RUNNER_LAUNCHER below), and it is also where the
# script dir comes from — one resolution, so the two can't disagree. Resolving through the
# symlink matters: the PATH entry install.sh creates is ~/.local/bin/menubar-load-runner
# pointing into the install dir, and a restart has to run the real file, not the link's name
# joined to the real dir.
resolve_script_path() {
  local source dir
  # In zsh functions, $0 is the function name; %x is the current script path.
  source="${(%):-%x}"

  if [[ "$source" != */* ]]; then
    source="$(command -v -- "$source" || true)"
    if [[ -z "$source" ]]; then
      print -u2 "$APP_CMD_NAME: unable to resolve script path"
      return 1
    fi
  fi

  while [[ -h "$source" ]]; do
    dir="$(cd -P -- "$(dirname -- "$source")" && pwd)"
    source="$(readlink -- "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done

  dir="$(cd -P -- "$(dirname -- "$source")" && pwd)" || return 1
  print -- "$dir/${source:t}"
}

print_help() {
  cat <<EOF
Usage:
  $APP_CMD_NAME [dog-white|dog-black|horse-black|horse-white|chihiro|chihiro-white|chihiro-black|totoro|totoro-group-white|totoro-group-black|totoro-white|totoro-black|/path/to.gif] [--speed-multiplier <x>] [--load-source <cpu|memory|gpu|network|disk|fan|battery|temperature>] [--show-all-sources] [--label <off|value|text>] [--keep-awake <off|on|duration>] [--battery-threshold <pct|off>] [--no-update-check] [--foreground|--no-detach]
  MENUBAR_LOAD_RUNNER_PATH=/path/to.gif $APP_CMD_NAME [--speed-multiplier <x>] [--load-source <cpu|memory|gpu|network|disk|fan|battery|temperature>] [--show-all-sources] [--label <off|value|text>] [--keep-awake <off|on|duration>] [--battery-threshold <pct|off>] [--no-update-check] [--foreground|--no-detach]

Presets:
  dog-white   Built-in running dog (white)
  dog-black   Built-in running dog (black)
  horse-black  Built-in running horse (black)
  horse-white   Built-in running horse (white, default)
  chihiro  Built-in walking Chihiro (color)
  chihiro-white  Built-in walking Chihiro (white silhouette)
  chihiro-black  Built-in walking Chihiro (black silhouette)
  totoro  Built-in running Totoro
  totoro-group-white  Built-in Totoro group GIF (white, transparent)
  totoro-group-black  Built-in Totoro group GIF (black, transparent)
  totoro-white  Built-in running Totoro (white)
  totoro-black  Built-in running Totoro (black)

Options:
  --speed-multiplier <x>     Fixed speed (e.g. 0.5, 1.0, 1.5, 2.0)
  --load-source <src>        Reader driving the animation: cpu (default), memory, gpu, network, disk, fan, battery, temperature
                             (also via MENUBAR_LOAD_RUNNER_LOAD_SOURCE; unknown/unavailable -> cpu)
  --show-all-sources         Start with the menu's "Other Sources" list expanded, sampling every available
                             reader and showing each as a live row (also via MENUBAR_LOAD_RUNNER_SHOW_ALL=1;
                             click a row to switch source; the active source still drives the animation)
  --label <off|value|text>   Optional second menu-bar slot: 'value' shows the active source's live reading,
                             any other text is a fixed label (up to 24 chars), 'off' (default) shows nothing
                             (also via MENUBAR_LOAD_RUNNER_LABEL; switchable from the menu)
  --keep-awake <off|on|dur>  Arm Keep Awake at launch: 'on' until turned off, or a duration with a unit
                             (30m, 2h, 1h30m; up to 24h), 'off' (default) leaves it disabled
                             (also via MENUBAR_LOAD_RUNNER_KEEP_AWAKE; switchable from the menu).
                             An armed window is saved and resumed on the next launch; passing this
                             flag -- even as 'off' -- overrides what was saved
