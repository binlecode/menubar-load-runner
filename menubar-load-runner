}

# Compiles MenuBarLoadRunner.swift to the sibling binary when the source is newer (or the binary is
# missing). Returns 0 when the binary is current — already, or after a successful build — and 1 when
# swiftc failed, which is the caller's cue to fall back to the interpreted `swift`.
#
# -strict-concurrency=complete opts into full data-race checking (Swift 5 mode, so violations
# surface as warnings rather than breaking the build). The source is annotated @MainActor to satisfy
# it; see docs for the concurrency posture.
#
# The build goes to a temp and is renamed into place, never written over the binary directly:
# `--precompile` exists to run *while an instance is live*, and overwriting a running Mach-O in place
# corrupts the process paging out of it. rename(2) within one directory is atomic and leaves the live
# process holding its old inode. `tests/qa.sh` §6 asserts the live instance survives a rebuild.
compile_if_stale() {
  local swift_src="$1" swift_bin="$2"
  if [[ -x "$swift_bin" && ! "$swift_src" -nt "$swift_bin" ]]; then
    return 0
  fi
  if swiftc -O -strict-concurrency=complete "$swift_src" -o "$swift_bin.new" >/dev/null 2>&1; then
    mv -f -- "$swift_bin.new" "$swift_bin"
    return 0
  fi
  rm -f -- "$swift_bin.new"
  return 1
}

main() {
  if ! command -v swift >/dev/null 2>&1; then
    print -u2 "$APP_CMD_NAME: swift command not found"
    exit 127
  fi

  local script_dir launcher_path swift_module_cache
  local launch_detached=1
  local allow_extra=0
  local do_precompile=0
  local log_file pid
  local -a passthrough_args swift_cmd

  launcher_path="$(resolve_script_path)"
  script_dir="${launcher_path:h}"
  swift_module_cache="${SWIFT_MODULE_CACHE:-/tmp/swift-module-cache}"

  passthrough_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --foreground|--no-detach)
        launch_detached=0
        ;;
      --detach)
        launch_detached=1
        ;;
      --extra)
        allow_extra=1
        ;;
      --precompile)
        do_precompile=1
        ;;
      *)
        passthrough_args+=("$1")
        ;;
    esac
    shift
  done
  set -- "${passthrough_args[@]}"

  # Preset keyword → GIF path resolution lives in Swift (MenuBarLoadRunnerApp.init), and the
  # preset profiles + default preset now live in gifs/presets.json, so the launcher forwards the
  # positional arg unchanged and only intercepts its own --help.
  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help)
        print_help
        exit 0
        ;;
    esac
  fi

  local swift_src="$script_dir/MenuBarLoadRunner.swift"
  local swift_bin="$script_dir/MenuBarLoadRunner"

  # --precompile: build and stop. This is the app's half of a self-update — `git pull` moves the
  # source, and the compile that makes it runnable has to happen *before* the app quits, or the user
  # watches an empty menu bar for as long as swiftc takes (measured 6.5s warm, 32s on a cold clang
  # module cache, 132s once under load). Deliberately ahead of the singleton guard: its whole purpose
  # is to run while an instance is live, which is what the temp+rename in compile_if_stale is for.
  if (( do_precompile )); then
    if compile_if_stale "$swift_src" "$swift_bin"; then
      exit 0
    fi
    print -u2 "$APP_CMD_NAME: swiftc failed; the next launch compiles on demand or falls back to interpreted swift."
    exit 1
  fi

  # Enforce singleton unless --extra is specified. Ahead of the compile, so a duplicate launch costs
  # a pgrep rather than a full swiftc run — and, when the source is stale, so it can't start a second
  # build racing the one whose gap it wandered into.
  if (( ! allow_extra )); then
    # Match the compiled binary by its path — `/MenuBarLoadRunner` followed by a space
    # (it has args) or end-of-line (env-var mode, no positional). Args no longer carry a
    # `.gif` path now that Swift resolves preset keywords, so the old `.*\.gif` pattern
    # would miss keyword launches. The trailing `( |$)` keeps this from matching an editor
    # holding `MenuBarLoadRunner.swift` open, or a `swiftc`/`swift` build of the source.
    # (The interpreted `swift …/MenuBarLoadRunner.swift` fallback, used only when swiftc
    # fails, is intentionally not singleton-guarded.) pgrep -f excludes its own process;
    # the lowercase launcher path `menubar-load-runner` never matches this pattern.
    #
    # `-U "$(id -u)"` scopes the search to the calling user: plain `pgrep -f` sees every
    # user's processes, so with fast user switching this refused user B's *first* launch by
    # naming a PID in user A's session — one B can't see, click, or kill. The guard means
    # "don't stack instances in *my* menu bar", and the menu bar is per-session.
    local existing_pids
    existing_pids=($(pgrep -U "$(id -u)" -f "/MenuBarLoadRunner( |$)" || true))
    if [[ ${#existing_pids[@]} -gt 0 ]]; then
      print -u2 "$APP_CMD_NAME: An instance of MenuBarLoadRunner is already running (PID: ${existing_pids[*]})."
      print -u2 "Use --extra to launch multiple instances."
      exit 1
    fi
  fi

  if compile_if_stale "$swift_src" "$swift_bin"; then
    swift_cmd=("$swift_bin" "$@")
  else
    mkdir -p -- "$swift_module_cache"
    swift_cmd=(swift -strict-concurrency=complete -module-cache-path "$swift_module_cache" "$swift_src" "$@")
  fi

  # MENUBAR_LOAD_RUNNER_LAUNCHER / _LAUNCH_MODE are how the app answers "can I restart myself, and
  # how" for the update prompt's Restart button — it cannot infer that on its own, because a
  # detached run and a launchd-supervised one both reparent to pid 1. `detached` means "re-exec this
  # launcher once I've exited"; `attached` means the caller is waiting on us, so the app offers a
  # restart only when launchd is the caller — asked via `launchctl list`, NOT sniffed from
  # XPC_SERVICE_NAME, which a LaunchAgent job reports as "0" — and never steals a --foreground run
  # out from under the shell that started it. LAUNCHER is also what the app runs `--precompile`
  # through, so the swiftc invocation lives in this file only.
  if (( launch_detached )); then
    log_file="${MENUBAR_LOAD_RUNNER_LOG_FILE:-/tmp/menubar-load-runner.log}"
    mkdir -p -- "$(dirname -- "$log_file")"
    MENUBAR_LOAD_RUNNER_BIN_NAME="$APP_CMD_NAME" \
    MENUBAR_LOAD_RUNNER_LAUNCHER="$launcher_path" \
    MENUBAR_LOAD_RUNNER_LAUNCH_MODE="detached" \
      nohup "${swift_cmd[@]}" >>"$log_file" 2>&1 < /dev/null &
    pid=$!
    disown "$pid" 2>/dev/null || true
    print -- "$APP_CMD_NAME: started in background (pid=$pid, log=$log_file)"
    exit 0
  fi

  MENUBAR_LOAD_RUNNER_BIN_NAME="$APP_CMD_NAME" \
  MENUBAR_LOAD_RUNNER_LAUNCHER="$launcher_path" \
  MENUBAR_LOAD_RUNNER_LAUNCH_MODE="attached" \
    exec "${swift_cmd[@]}"
}

main "$@"
